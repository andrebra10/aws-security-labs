# Copy this file to terraform.tfvars and adjust at least allowed_ssh_cidr.

aws_region       = "eu-west-1"
project_name     = "ppk"

# Your own public IP in CIDR notation. Find it with `curl ifconfig.me`.
# 203.0.113.10/32 below is a documentation-only placeholder (RFC 5737 TEST-NET-3) - replace it.
allowed_ssh_cidr = "203.0.113.10/32"

github_repo_url  = "https://github.com/andrebra10/aws-security-labs.git"
